# Copy to .env (dev) or .env.prod (production) and fill in real values.
# Never commit the filled-in file — both are gitignored.

# Supabase project (Settings -> API). Use the service_role key, not anon —
# the backend bypasses RLS and enforces authorization itself.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Signs session JWTs. Must be a random string of 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

PORT=3000
NODE_ENV=development

# Frontend origin(s) allowed to call the API with cookies, e.g.
# http://localhost:8000 in dev or https://your-frontend-host in prod.
CORS_ORIGIN=http://localhost:8000

# Required when NODE_ENV=production (shared refresh-token denylist across
# instances). Optional in development — falls back to an in-memory denylist
# that does not survive a restart or work across multiple processes.
REDIS_URL=

# Set to false in production to turn off the public /api/docs Swagger UI.
DOCS_ENABLED=true
